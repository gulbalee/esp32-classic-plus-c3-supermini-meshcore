  +<../variants/my_esp32_sx1278>

[env:my_esp32_sx1278_repeater]
extends = my_esp32_sx1278
build_flags =
    ${my_esp32_sx1278.build_flags}
    -D ADVERT_NAME='"PARS MeshCore Repeater"'
    -D ADVERT_LAT=33.6007
    -D ADVERT_LON=73.0679
    -D ADMIN_PASSWORD='"pakistan"'
    -D MAX_NEIGHBOURS=8
build_src_filter = ${my_esp32_sx1278.build_src_filter}
    +<../examples/simple_repeater>
lib_deps =
    ${my_esp32_sx1278.lib_deps}
    ${esp32_ota.lib_deps}

[env:my_esp32_sx1278_repeater_bridge_espnow]
extends = my_esp32_sx1278
build_flags =
    ${my_esp32_sx1278.build_flags}
    -D ADVERT_NAME='"PARS MeshCore Repeater"'
    -D ADVERT_LAT=33.6007
    -D ADVERT_LON=73.0679
    -D ADMIN_PASSWORD='"pakistan"'
    -D MAX_NEIGHBOURS=8
    -D WITH_ESPNOW_BRIDGE=1
build_src_filter = ${my_esp32_sx1278.build_src_filter}
    +<helpers/bridges/ESPNowBridge.cpp>
    +<../examples/simple_repeater>
lib_deps =
    ${my_esp32_sx1278.lib_deps}
    ${esp32_ota.lib_deps}
