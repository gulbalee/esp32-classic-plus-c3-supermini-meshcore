[my_esp32_sx1278]
extends = esp32_base
board = esp32dev
build_flags =
  ${esp32_base.build_flags}
  -I variants/my_esp32_sx1278
  -D RADIO_CLASS=CustomSX1276
  -D WRAPPER_CLASS=CustomSX1276Wrapper
  -D P_LORA_DIO_0=26
  -D P_LORA_DIO_1=32
  -D P_LORA_NSS=5
  -D P_LORA_RESET=14
  -D P_LORA_SCLK=18
  -D P_LORA_MISO=19
